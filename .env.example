# Variáveis de ambiente — Nexus ERP
# Copie para .env.local (dev) ou configure no provedor (produção)

# Ambiente: development | staging | production
VITE_APP_ENV=development

# Supabase (Nexus 3.0 — PostgreSQL multi-tenant)
# Obtenha em: https://supabase.com/dashboard/project/_/settings/api
# VITE_SUPABASE_URL=https://seu-projeto.supabase.co
# VITE_SUPABASE_ANON_KEY=sua-anon-key

# URL da API (Fase 2 — SaaS)
# VITE_API_URL=https://api.nexuserp.com.br

# Monitoramento (Fase 1+)
# VITE_SENTRY_DSN=

# Analytics
# VITE_ANALYTICS_ID=

# IA — chaves ficam no client hoje; migrar para proxy backend na Fase 2
# VITE_OPENAI_PROXY=/api/ai
