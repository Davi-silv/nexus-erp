{
  "name": "nexus-erp",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:landing": "npx --yes serve marketing -l tcp://127.0.0.1:3000",
    "open:app": "bash scripts/open-app.sh",
    "open:landing": "bash scripts/open-landing.sh",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "bash scripts/test-e2e.sh",
    "test:e2e:ui": "bash scripts/test-e2e.sh --ui",
    "test:all": "npm test && npm run test:e2e",
    "spell": "cspell \"{src,index.html,css,tests,scripts,docs,supabase}/**/*.{js,html,css,md,sql,sh}\" cspell.json package.json vite.config.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "javascript-obfuscator": "^5.4.2"
  },
  "devDependencies": {
    "@cspell/dict-pt-br": "^2.4.2",
    "@playwright/test": "^1.62.1",
    "cspell": "^10.1.1",
    "jsdom": "^30.0.1",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.0.0"
  }
}
